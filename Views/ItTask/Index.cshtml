@model List<wt_lab4_4mvc_findrik.Models.ItTask>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог задач</h1>
            <p class="text-muted" style="color: #252420 !important;">Система управления IT-проектами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить задачу</a>
    </div>

    <div class="row g-4">
        @foreach (var task in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-secondary">ID: @task.Id</span>
                        </div>
                        <h5 class="card-title fw-bold">@task.Title</h5>
                        <p class="mb-1">Проект: @task.ProjectName</p>
                        <p class="mb-2">Приоритет: <span class="badge bg-info">@task.Priority</span></p>
                        <p class="fs-4 fw-bold mb-2">@task.EstimatedHours ч.</p>
                        <p class="mb-3">Выполнено: @(task.IsCompleted ? "Да" : "Нет")</p>
                        
                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-warning btn-sm">Редактировать</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>